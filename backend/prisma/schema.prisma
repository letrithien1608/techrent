// TechRent — Prisma schema
// Xem mục 8 (Database Schema) trong TechRent-Roadmap.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  admin
}

enum DeviceStatus {
  available
  rented
  maintenance
  broken
  // Khách không trả máy, admin xác nhận mất — kèm isDiscontinued để ẩn khỏi trang khách.
  lost
}

enum BookingStatus {
  pending
  confirmed
  ongoing
  completed
  cancelled
  // Trạng thái cuối khi admin xác nhận khách không trả máy (mất thiết bị).
  lost
}

enum PaymentMethod {
  vnpay
  momo
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

// Hình thức thu tiền thuê tại quầy khi giao máy (VNPay chỉ thu tiền cọc).
enum RentalPaymentMethod {
  cash
  bank_transfer
}

// Trạng thái hoàn cọc — tách khỏi BookingStatus để đơn đã trả máy/đã huỷ vẫn
// theo dõi được khoản cọc còn phải chuyển khoản lại cho khách.
//   none          — chưa tới bước hoàn cọc (chưa thu cọc / đang thuê / đơn cũ)
//   pending       — chờ nhân viên chuyển khoản (hạn: DEPOSIT_REFUND_BUSINESS_DAYS)
//   refunded      — đã chuyển khoản, có mã giao dịch
//   not_refunded  — không hoàn (huỷ sát giờ, hoặc phí trễ/hư hỏng ≥ tiền cọc)
enum DepositRefundStatus {
  none
  pending
  refunded
  not_refunded
}

// Biên bản kiểm tra thiết bị. Phiên sau có thể thêm loại (VD đổi máy giữa kỳ
// thuê) chỉ bằng 1 giá trị enum mới, không đổi cấu trúc bảng.
enum InspectionType {
  handover
  return
}

enum DeviceCondition {
  intact
  damaged
  missing_accessories
}

// Báo lỗi thiết bị giữa kỳ thuê (khách gửi từ đơn đang thuê).
enum IssueReportStatus {
  open
  resolved
}

//   swapped        — lỗi do thiết bị, đổi sang máy tương đương
//   ended_early    — lỗi do thiết bị, kết thúc sớm: hoàn tiền thuê phần chưa dùng + đủ cọc
//   customer_fault — lỗi do khách: ghi chi phí sửa, trừ vào cọc khi trả máy
enum IssueResolution {
  swapped
  ended_early
  customer_fault
}

enum MaintenanceStatus {
  open
  in_progress
  resolved
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique(map: "idx_users_email")
  // NULL = tài khoản đăng ký bằng Google/Facebook chưa đặt mật khẩu (không
  // đăng nhập bằng email + mật khẩu được cho tới khi tự "Đặt mật khẩu").
  passwordHash      String?  @map("password_hash")
  refreshTokenHash  String?  @map("refresh_token_hash")
  role              Role     @default(customer)
  // Cả phone lẫn cccdHash đều unique CẤP DATABASE (không chỉ validate ở tầng
  // ứng dụng) — chống 1 người tạo nhiều tài khoản để thuê rồi chiếm đoạt (mục
  // 7 Roadmap), và là lớp bảo vệ cuối cùng chống race condition khi 2 request
  // đăng ký cùng lúc dùng chung 1 SĐT/CCCD. Nullable để KHÔNG phá dữ liệu user
  // cũ đã tồn tại trước khi tính năng này được thêm (Postgres cho phép nhiều
  // NULL cùng lúc trong 1 unique index — NULL không coi là trùng NULL khác).
  phone             String?  @unique(map: "idx_users_phone")
  // Hash 1 chiều (SHA-256) của CCCD — dùng để kiểm tra trùng lặp qua unique
  // index mà KHÔNG cần giải mã lại. KHÔNG thể đảo ngược về số CCCD gốc.
  cccdHash          String?  @unique(map: "idx_users_cccd_hash") @map("cccd_hash")
  // Mã hoá 2 chiều (AES-256-GCM) — LƯU giá trị CCCD gốc, chỉ giải mã được ở
  // đúng 1 endpoint admin xem để xác minh tranh chấp thật (xem UsersService).
  cccdEncrypted     String?  @map("cccd_encrypted")
  // Bản che bớt tính sẵn lúc ghi (VD "********1234") — dùng để HIỂN THỊ, tránh
  // phải giải mã cccdEncrypted mỗi lần đọc thông thường (giảm bề mặt lộ dữ liệu).
  cccdMasked        String?  @map("cccd_masked")
  // eKYC (mở rộng 22/10) — ảnh CCCD mặt trước/sau + ảnh chân dung xác thực
  // khuôn mặt. CHỈ lưu Cloudinary `public_id` (KHÔNG BAO GIỜ lưu URL) — ảnh
  // upload với `type: 'private'`, Cloudinary từ chối truy cập trực tiếp nếu
  // không có URL ký kèm `expires_at` ngắn hạn (đã verify THẬT: Cloudinary trả
  // 401 "Stale request" sau khi hết hạn — xem UploadService.generateKycImageViewUrl
  // và CLAUDE.md). Nhạy cảm HƠN cả số CCCD (giấy tờ tuỳ thân + sinh trắc học),
  // nên mức bảo vệ CAO HƠN cccdEncrypted (vốn chỉ cần mã hoá tại chỗ, ảnh thì
  // không thể "mã hoá" theo kiểu field text nên bảo vệ ở tầng lưu trữ/truy cập).
  kycCccdFrontPublicId String? @map("kyc_cccd_front_public_id")
  kycCccdBackPublicId  String? @map("kyc_cccd_back_public_id")
  kycSelfiePublicId    String? @map("kyc_selfie_public_id")
  // Ảnh đại diện (04/11) — ảnh CÔNG KHAI (khác hẳn ảnh eKYC riêng tư ở trên):
  // thư mục Cloudinary `techrent/avatars`, resize 256x256. Lưu cả public_id (để
  // xoá ảnh cũ) lẫn URL hiển thị (đọc thẳng, không cần ký).
  avatarPublicId    String?  @map("avatar_public_id")
  avatarUrl         String?  @map("avatar_url")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  // Danh sách đen (mở rộng 22/10 buổi 6) — admin đánh dấu khi khách chiếm giữ/
  // không trả thiết bị. Chặn NGAY tại `BookingsService.create()`. Chặn "theo
  // CCCD, không chỉ theo tài khoản" được đảm bảo bằng cách KHÔNG CHO XOÁ user
  // đã blacklist (`UsersService.remove()`) — giữ nguyên hàng đó nên `cccdHash`
  // unique vẫn còn chiếm giữ vĩnh viễn, khiến `AuthService.register()` (đã có
  // sẵn check trùng cccdHash) tự động chặn CCCD đó đăng ký tài khoản mới khác,
  // KHÔNG cần thêm bảng/cơ chế tra cứu riêng — tái dùng đúng unique cccdHash.
  isBlacklisted     Boolean   @default(false) @map("is_blacklisted")
  blacklistReason   String?   @db.Text @map("blacklist_reason")
  blacklistedAt     DateTime? @map("blacklisted_at")
  createdAt         DateTime @default(now()) @map("created_at")

  bookings          Booking[]
  reviews           Review[]
  reportedIssues    Maintenance[]  @relation("ReportedBy")
  notifications     Notification[]
  socialAccounts    SocialAccount[]

  @@map("users")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  // Mẫu thông số kỹ thuật của danh mục: [{ group, fields: [label] }]. Form admin
  // dựng ô nhập theo mẫu này; trang chi tiết nhóm bảng thông số theo thứ tự này.
  specTemplate Json?  @map("spec_template")

  devices     Device[]

  @@map("categories")
}

model Device {
  id            String       @id @default(uuid())
  name          String
  categoryId    String       @map("category_id")
  specs         Json?
  // Thông số kỹ thuật có cấu trúc, tra từ nguồn thật (xem docs/device-sources.md):
  // [{ group, label, value }] theo mẫu `Category.specTemplate`. `specs` ở trên là
  // dạng cũ key-value, giữ để tương thích ngược.
  specSheet     Json?        @map("spec_sheet")
  status        DeviceStatus @default(available)
  pricePerHour  Decimal      @map("price_per_hour") @db.Decimal(10, 2)
  pricePerDay   Decimal      @map("price_per_day") @db.Decimal(10, 2)
  // Giá gốc/giá trị tài sản của thiết bị — TÁCH BIỆT với giá thuê theo giờ/
  // ngày ở trên. Dùng để tính tiền cọc (50% originalPrice, xem BookingsService)
  // và hiển thị minh bạch cho khách ở trang chi tiết thiết bị.
  originalPrice Decimal      @map("original_price") @db.Decimal(12, 2)
  images        String[]
  // Mô tả dài: tình trạng máy, phụ kiện đi kèm, bảo hành còn lại, năm sản
  // xuất... — KHÁC `specs` (JSON tự do, field-value ngắn) ở trên, đây là văn
  // bản tự do dài hơn, hiển thị riêng ở trang chi tiết. Nullable vì không bắt
  // buộc (thiết bị cũ trước khi có field này không có).
  detailedDescription String?   @map("detailed_description") @db.Text
  // Số serial/IMEI của máy cụ thể — in trong hợp đồng thuê để xác định đúng
  // tài sản. Bắt buộc khi admin tạo/sửa (DTO); nullable ở DB chỉ để không phá
  // dữ liệu cũ (migration đã backfill số mẫu cho thiết bị có sẵn).
  serialNumber  String?      @unique(map: "uq_devices_serial_number") @map("serial_number")
  // Hãng sản xuất (VD "Sony") — in trong hợp đồng; model in theo tên thiết bị.
  brand         String?
  // Phụ kiện giao kèm: [{ name, quantity }] — bảng phụ kiện trong hợp đồng/biên bản.
  accessories   Json         @default("[]")
  createdAt     DateTime     @default(now()) @map("created_at")
  // Denormalize từ Review (đánh giá đang hiển thị, chưa bị xoá) — tính lại mỗi
  // khi tạo/sửa/xoá/ẩn đánh giá (cùng transaction với thay đổi đó), KHÔNG
  // tự aggregate mỗi lần GET /devices (tốn kém với danh sách phân trang). Xem
  // quyết định "KHÔNG làm" ban đầu rồi đổi ý ở CLAUDE.md — lý do trước đó là
  // thiếu dữ liệu thật, giờ triển khai đúng hướng denormalize đã ghi nhận.
  // Ngừng kinh doanh (VD danh mục bị bỏ) nhưng thiết bị ĐÃ có lịch sử đơn/bảo
  // trì nên không xoá cứng — ẩn khỏi trang khách, chặn đặt mới, giữ nguyên lịch
  // sử đơn/hợp đồng/doanh thu. Xem backend/scripts/catalog/remove-categories.ts.
  isDiscontinued Boolean     @default(false) @map("is_discontinued")
  discontinuedAt DateTime?   @map("discontinued_at")
  avgRating     Float?       @map("avg_rating")
  reviewCount   Int          @default(0) @map("review_count")

  category      Category      @relation(fields: [categoryId], references: [id])
  bookings      Booking[]
  maintenance   Maintenance[]
  reviews       Review[]

  @@index([categoryId, status], map: "idx_devices_category_status")
  @@map("devices")
}

model Booking {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  deviceId       String        @map("device_id")
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  status         BookingStatus @default(pending)
  totalPrice     Decimal       @map("total_price") @db.Decimal(10, 2)
  depositAmount  Decimal       @map("deposit_amount") @db.Decimal(10, 2)
  // Hợp đồng thuê — nội dung text tự sinh khi booking chuyển sang `confirmed`
  // (xem BookingsService.confirm()/PaymentsService.confirmBookingAfterPayment(),
  // luôn lưu CCCD dạng MASKED — bản đầy đủ CCCD chỉ sinh TẠM lúc admin in, không
  // lưu lại). `contractSigned` do nhân viên tự đánh dấu sau khi khách ký tay.
  contractContent  String?   @map("contract_content") @db.Text
  contractSigned   Boolean   @default(false) @map("contract_signed")
  contractSignedAt DateTime? @map("contract_signed_at")
  // Phí trễ hạn leo thang — tính khi nhân viên xác nhận trả máy (confirmReturn)
  // nếu trả sau `endTime`, TRỪ vào tiền cọc. `totalPrice` chỉ là tiền thuê
  // (từ 03/11 không còn cộng phí trễ vào — migration đã tách lại cho đơn cũ).
  lateFeeAmount  Decimal       @default(0) @map("late_fee_amount") @db.Decimal(10, 2)
  // Ai đã xác nhận/huỷ đơn (staff/admin hoặc chính khách) — để thông báo hiển
  // thị đúng "Đã xác nhận bởi ..." và trạng thái thật khi nhiều admin cùng thấy
  // 1 đơn. NULL khi xác nhận tự động (IPN VNPay) hoặc huỷ tự động (TTL). Cố ý
  // KHÔNG khai báo quan hệ Prisma tới User (chỉ cần tra tên để hiển thị).
  confirmedById      String?   @map("confirmed_by_id")
  cancelledById      String?   @map("cancelled_by_id")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  // Tiền thuê (`totalPrice`) thu tại quầy khi giao máy — nhân viên bấm "Đã thu
  // tiền thuê". Không cho chuyển `ongoing` nếu chưa thu (xem BookingsService.start()).
  rentalPaid          Boolean              @default(false) @map("rental_paid")
  rentalPaidAt        DateTime?            @map("rental_paid_at")
  rentalPaymentMethod RentalPaymentMethod? @map("rental_payment_method")
  rentalCollectedById String?              @map("rental_collected_by_id")
  // Quyết toán khi trả máy: tiền hoàn cọc = cọc − phí trễ hạn − phí hư hỏng.
  // Âm thì hoàn 0 và lưu phần thiếu vào `amountOwed` (khách còn nợ).
  returnedAt          DateTime?            @map("returned_at")
  damageFeeAmount     Decimal              @default(0) @map("damage_fee_amount") @db.Decimal(12, 2)
  amountOwed          Decimal              @default(0) @map("amount_owed") @db.Decimal(12, 2)
  depositRefundStatus DepositRefundStatus  @default(none) @map("deposit_refund_status")
  depositRefundAmount Decimal              @default(0) @map("deposit_refund_amount") @db.Decimal(12, 2)
  depositRefundDueAt  DateTime?            @map("deposit_refund_due_at")
  depositRefundedAt   DateTime?            @map("deposit_refunded_at")
  depositRefundTxnRef String?              @map("deposit_refund_txn_ref")
  depositRefundedById String?              @map("deposit_refunded_by_id")
  // Chi phí sửa chữa do lỗi của khách (ghi khi xử lý báo lỗi) — trừ vào cọc khi trả máy.
  repairFeeAmount     Decimal              @default(0) @map("repair_fee_amount") @db.Decimal(12, 2)
  // Tiền thuê hoàn lại khi kết thúc sớm do lỗi thiết bị — chuyển khoản cùng khoản hoàn cọc.
  rentalRefundAmount  Decimal              @default(0) @map("rental_refund_amount") @db.Decimal(12, 2)
  // Quá hạn trả LOST_SUSPECT_OVERDUE_DAYS ngày → job đánh dấu nghi mất; admin xác nhận → status `lost`.
  suspectedLostAt     DateTime?            @map("suspected_lost_at")
  lostConfirmedAt     DateTime?            @map("lost_confirmed_at")
  // Đã thu được bao nhiêu trong `amountOwed` — còn nợ = amountOwed − debtPaidAmount.
  debtPaidAmount      Decimal              @default(0) @map("debt_paid_amount") @db.Decimal(12, 2)
  // Đơn dữ liệu mẫu (prisma/seed-reviews.ts, tài khoản demo.review*) — loại khỏi mọi thống kê.
  isDemo              Boolean              @default(false) @map("is_demo")
  createdAt      DateTime      @default(now()) @map("created_at")

  user        User                @relation(fields: [userId], references: [id])
  device      Device              @relation(fields: [deviceId], references: [id])
  payments    Payment[]
  review      Review?
  inspections BookingInspection[]
  issueReports DeviceIssueReport[]
  debtPayments DebtPayment[]

  @@index([deviceId, startTime, endTime], map: "idx_bookings_device_time")
  @@index([userId], map: "idx_bookings_user")
  @@index([depositRefundStatus, depositRefundDueAt], map: "idx_bookings_deposit_refund")
  @@map("bookings")
}

// Biên bản giao máy / nhận lại máy: ảnh tình trạng thiết bị (Cloudinary) + ghi
// chú. Ảnh lúc giao và lúc trả đặt cạnh nhau để làm căn cứ tính phí hư hỏng.
model BookingInspection {
  id                String           @id @default(uuid())
  bookingId         String           @map("booking_id")
  type              InspectionType
  images            String[]
  notes             String?          @db.Text
  condition         DeviceCondition  @default(intact)
  damageDescription String?          @map("damage_description") @db.Text
  performedById     String           @map("performed_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, type], map: "uq_booking_inspections_booking_type")
  @@map("booking_inspections")
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId], map: "idx_payments_booking_id")
  @@index([transactionId], map: "idx_payments_transaction_id")
  @@map("payments")
}

model Maintenance {
  id          String             @id @default(uuid())
  deviceId    String             @map("device_id")
  reportedBy  String             @map("reported_by")
  issue       String
  status      MaintenanceStatus  @default(open)
  resolvedAt  DateTime?          @map("resolved_at")

  device   Device @relation(fields: [deviceId], references: [id])
  reporter User   @relation("ReportedBy", fields: [reportedBy], references: [id])

  @@index([deviceId, status], map: "idx_maintenance_device_status")
  @@map("maintenance")
}

model Review {
  id           String    @id @default(uuid())
  // Từ 04/11 mọi khách đã đăng nhập đều đánh giá được (không cần đã thuê) —
  // bookingId chỉ còn ở đánh giá cũ (luật "phải thuê" trước đó). Nhãn "Đã thuê
  // thiết bị này" tính trực tiếp từ đơn completed, KHÔNG đọc cột này.
  bookingId    String?   @unique @map("booking_id")
  // Mỗi khách CHỈ 1 đánh giá cho 1 thiết bị — chặn ở cấp database.
  userId       String    @map("user_id")
  deviceId     String    @map("device_id")
  rating       Int
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  // NULL = chưa từng sửa; có giá trị → hiển thị "đã chỉnh sửa".
  editedAt     DateTime? @map("edited_at")
  // Giới hạn sửa theo ngày (giờ VN): editDay = "YYYY-MM-DD" của lần sửa gần
  // nhất, editCount = số lần sửa trong ngày đó.
  editDay      String?   @map("edit_day")
  editCount    Int       @default(0) @map("edit_count")
  // Admin/staff ẩn đánh giá vi phạm (không sửa nội dung). Đánh giá ẩn không tính
  // vào avgRating/reviewCount và không hiện ở trang công khai.
  isHidden     Boolean   @default(false) @map("is_hidden")
  hiddenReason String?   @map("hidden_reason") @db.Text
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id")
  // Xoá mềm bởi staff/admin (kèm lý do) — giữ hàng để đối chiếu khiếu nại VÀ để
  // unique (user, device) tiếp tục chặn khách viết lại. Khách tự xoá → xoá hẳn.
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")
  deleteReason String?   @map("delete_reason") @db.Text

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  device  Device   @relation(fields: [deviceId], references: [id])

  @@unique([userId, deviceId], map: "uq_reviews_user_device")
  @@index([deviceId, isHidden, createdAt], map: "idx_reviews_device_visible")
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  // Tiêu đề ngắn + đường dẫn tới trang liên quan + dữ liệu chi tiết (bookingId,
  // tên/ảnh thiết bị, tên khách, thời gian thuê, số tiền...) để giao diện hiển
  // thị phong phú và điều hướng đúng. Thông báo cũ: title backfill theo type
  // trong migration, link NULL, metadata '{}' — vẫn hiển thị bình thường.
  title     String?
  message   String
  link      String?
  metadata  Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  // Truy vấn chính của module: "danh sách thông báo của user X, mới nhất
  // trước" (GET /notifications) — index (userId, createdAt) phục vụ đúng cả
  // filter lẫn order, cùng pattern idx_payments_booking_id/idx_maintenance_device_status.
  @@index([userId, createdAt], map: "idx_notifications_user_id_created_at")
  @@map("notifications")
}

// Khách báo lỗi thiết bị giữa kỳ thuê + cách nhân viên xử lý.
model DeviceIssueReport {
  id                     String             @id @default(uuid())
  bookingId              String             @map("booking_id")
  reportedById           String             @map("reported_by_id")
  // Thiết bị tại thời điểm báo lỗi (đơn có thể đã đổi sang máy khác sau đó).
  deviceId               String             @map("device_id")
  description            String             @db.Text
  // URL ảnh/video Cloudinary (video có "/video/upload/" trong URL).
  media                  String[]
  status                 IssueReportStatus  @default(open)
  resolution             IssueResolution?
  resolutionNote         String?            @map("resolution_note") @db.Text
  repairCost             Decimal            @default(0) @map("repair_cost") @db.Decimal(12, 2)
  replacementDeviceId    String?            @map("replacement_device_id")
  // Ảnh biên bản giao máy cũ (trước khi đổi máy) — biên bản giao máy được thay bằng ảnh máy mới.
  previousHandoverImages String[]           @map("previous_handover_images")
  rentalRefundAmount     Decimal            @default(0) @map("rental_refund_amount") @db.Decimal(12, 2)
  resolvedById           String?            @map("resolved_by_id")
  resolvedAt             DateTime?          @map("resolved_at")
  createdAt              DateTime           @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status, createdAt], map: "idx_issue_reports_status")
  @@index([bookingId], map: "idx_issue_reports_booking")
  @@map("device_issue_reports")
}

// Lịch sử thu nợ (nhân viên bấm "Đã thu nợ"), mỗi lần thu gắn với 1 đơn.
model DebtPayment {
  id            String              @id @default(uuid())
  bookingId     String              @map("booking_id")
  userId        String              @map("user_id")
  amount        Decimal             @db.Decimal(12, 2)
  method        RentalPaymentMethod
  note          String?             @db.Text
  collectedById String              @map("collected_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([userId], map: "idx_debt_payments_user")
  @@map("debt_payments")
}

enum SocialProvider {
  google
  facebook
}

// Danh tính Google/Facebook gắn với 1 user. CHỈ thay bước nhập email + mật
// khẩu — user vẫn phải đăng ký đủ SĐT/CCCD như đăng ký thường mới có hàng ở
// đây. 1 tài khoản Google/Facebook chỉ gắn với đúng 1 user (unique).
model SocialAccount {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  email          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "idx_social_accounts_provider_user")
  @@unique([userId, provider], map: "idx_social_accounts_user_provider")
  @@map("social_accounts")
}
