// TechRent — Prisma schema
// Xem mục 8 (Database Schema) trong TechRent-Roadmap.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  admin
}

enum DeviceStatus {
  available
  rented
  maintenance
  broken
}

enum BookingStatus {
  pending
  confirmed
  ongoing
  completed
  cancelled
}

enum PaymentMethod {
  vnpay
  momo
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum MaintenanceStatus {
  open
  in_progress
  resolved
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique(map: "idx_users_email")
  passwordHash      String   @map("password_hash")
  refreshTokenHash  String?  @map("refresh_token_hash")
  role              Role     @default(customer)
  phone             String?
  cccdEncrypted     String?  @map("cccd_encrypted")
  createdAt         DateTime @default(now()) @map("created_at")

  bookings          Booking[]
  reportedIssues    Maintenance[]  @relation("ReportedBy")
  notifications     Notification[]

  @@map("users")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?

  devices     Device[]

  @@map("categories")
}

model Device {
  id            String       @id @default(uuid())
  name          String
  categoryId    String       @map("category_id")
  specs         Json?
  status        DeviceStatus @default(available)
  pricePerHour  Decimal      @map("price_per_hour") @db.Decimal(10, 2)
  pricePerDay   Decimal      @map("price_per_day") @db.Decimal(10, 2)
  images        String[]
  createdAt     DateTime     @default(now()) @map("created_at")

  category      Category      @relation(fields: [categoryId], references: [id])
  bookings      Booking[]
  maintenance   Maintenance[]

  @@index([categoryId, status], map: "idx_devices_category_status")
  @@map("devices")
}

model Booking {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  deviceId       String        @map("device_id")
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  status         BookingStatus @default(pending)
  totalPrice     Decimal       @map("total_price") @db.Decimal(10, 2)
  depositAmount  Decimal       @map("deposit_amount") @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  device   Device    @relation(fields: [deviceId], references: [id])
  payments Payment[]
  review   Review?

  @@index([deviceId, startTime, endTime], map: "idx_bookings_device_time")
  @@index([userId], map: "idx_bookings_user")
  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Maintenance {
  id          String             @id @default(uuid())
  deviceId    String             @map("device_id")
  reportedBy  String             @map("reported_by")
  issue       String
  status      MaintenanceStatus  @default(open)
  resolvedAt  DateTime?          @map("resolved_at")

  device   Device @relation(fields: [deviceId], references: [id])
  reporter User   @relation("ReportedBy", fields: [reportedBy], references: [id])

  @@map("maintenance")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
